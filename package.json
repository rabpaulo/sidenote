{
  "name": "interviewai",
  "version": "1.0.0",
  "description": "InterviewAI Meeting & Voice Copilot clone tailored for coding agents (Antigravity)",
  "author": "InterviewAI",
  "desktopName": "interviewai.desktop",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "desktop": "electron .",
    "build": "vite build",
    "build:appimage": "npm run build && electron-builder --linux appimage",
    "build:win": "npm run build && electron-builder --win --x64",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "node --test server/*.test.js shared/*.test.js src/hooks/*.test.js src/components/*.test.js scripts/*.test.js",
    "eval:copilot": "node scripts/evaluate-copilot.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.6",
    "express": "^4.21.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "unpdf": "^1.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  }
}
