{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "io.github.rabpaulo.sidenote",
  "productName": "Sidenote",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "server/**/*",
    "shared/**/*",
    "build/icon.png",
    "!**/*.test.js",
    "!server/fixtures/**/*",
    "!**/__pycache__/**",
    "package.json"
  ],
  "asar": false,
  "linux": {
    "target": [
      {
        "target": "appimage",
        "arch": ["x64"]
      }
    ],
    "category": "Utility",
    "icon": "build/icon.png",
    "synopsis": "Copiloto de conversas em tempo real",
    "description": "Transcreve reuniões e conversas, sugere respostas e resume o que foi dito.",
    "syncDesktopName": true
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "artifactName": "${productName}-${version}-setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "Sidenote"
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}"
  }
}
